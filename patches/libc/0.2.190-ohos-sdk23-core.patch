+// Bounded experimental profile, not a replacement for the full Linux ABI target.
+fn test_ohos_sdk23_core(t: &Target) {
+    assert_eq!(t.triple, "x86_64-unknown-linux-ohos");
+    let mut cfg = ctest_cfg();
+    cfg.define("_GNU_SOURCE", None);
+    for header in ["sys/types.h", "sys/stat.h", "sys/time.h", "sys/uio.h",
+        "sys/mman.h", "sys/socket.h", "netinet/in.h", "unistd.h", "fcntl.h",
+        "stdlib.h", "stdio.h", "string.h", "time.h", "errno.h", "poll.h"] {
+        cfg.header(header);
+    }
+    cfg.skip_alias(|a| ![
+        "c_char", "c_schar", "c_uchar", "c_short", "c_ushort", "c_int", "c_uint",
+        "c_long", "c_ulong", "c_longlong", "c_ulonglong", "size_t", "ssize_t",
+        "off_t", "mode_t", "pid_t", "uid_t", "gid_t", "time_t", "suseconds_t",
+        "clockid_t", "socklen_t", "sa_family_t", "in_port_t", "in_addr_t", "nfds_t",
+    ].contains(&a.ident()));
+    cfg.skip_struct(|s| ![
+        "timespec", "timeval", "stat", "iovec", "pollfd", "sockaddr", "sockaddr_in",
+        "in_addr", "linger",
+    ].contains(&s.ident()));
+    cfg.skip_union(|_| true);
+    cfg.skip_static(|_| true);
+    cfg.skip_const(|c| ![
+        "O_RDONLY", "O_WRONLY", "O_RDWR", "O_CREAT", "O_EXCL", "O_TRUNC", "O_APPEND",
+        "O_CLOEXEC", "SEEK_SET", "SEEK_CUR", "SEEK_END", "S_IFMT", "S_IFREG", "S_IFDIR",
+        "S_IRUSR", "S_IWUSR", "S_IXUSR", "EACCES", "EEXIST", "EINTR", "EINVAL",
+        "ENOENT", "ENOMEM", "EPERM", "EOF", "EXIT_SUCCESS", "EXIT_FAILURE",
+        "PROT_NONE", "PROT_READ", "PROT_WRITE", "MAP_PRIVATE", "MAP_SHARED",
+        "MAP_ANONYMOUS", "AF_INET", "SOCK_STREAM", "SOCK_DGRAM", "SOL_SOCKET",
+        "SO_REUSEADDR", "SHUT_RD", "SHUT_WR", "SHUT_RDWR", "POLLIN", "POLLOUT",
+        "POLLERR", "POLLHUP", "CLOCK_REALTIME", "CLOCK_MONOTONIC",
+    ].contains(&c.ident()));
+    cfg.skip_fn(|f| ![
+        "open", "close", "read", "write", "pread", "pwrite", "lseek", "unlink",
+        "rename", "mkdir", "rmdir", "stat", "fstat", "lstat", "chmod", "fchmod",
+        "fsync", "fdatasync", "dup", "dup2", "fcntl", "access", "getpid", "getuid",
+        "getgid", "malloc", "calloc", "realloc", "free", "memcpy", "memmove",
+        "memset", "memcmp", "strlen", "strcmp", "strcpy", "clock_gettime",
+        "gettimeofday", "nanosleep", "time", "socket", "bind", "listen", "accept",
+        "connect", "getsockname", "getpeername", "getsockopt", "setsockopt",
+        "shutdown", "send", "recv", "sendto", "recvfrom", "poll", "readv", "writev",
+        "mmap", "munmap", "mprotect",
+    ].contains(&f.ident()));
+    cfg.rename_struct_field(|s, f| {
+        (s.ident() == "stat" && f.ident().ends_with("_nsec"))
+            .then(|| f.ident().replace("e_nsec", ".tv_nsec"))
+    });
+    ctest::generate_test(&mut cfg, "../src/lib.rs", "ctest_output.rs").unwrap();
 }
 
